<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net48;net461</TargetFrameworks>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>AdaptaPE</AssemblyName>
    <Version>1.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <FileVersion>1.0.3.0</FileVersion>
    <ApplicationIcon>../../assets/brand/AdaptaPE.ico</ApplicationIcon>
    <!-- La UI principal es WPF: DPI se declara en manifiesto antes de crear HWND. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../../assets/mascotas/*.png;../../assets/mascotas/*.json" Link="mascotas/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="OpenCvSharp4" Version="4.10.0.20241108" Condition="'$(TargetFramework)' != 'net461'" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.10.0.20241108" Condition="'$(TargetFramework)' != 'net461'" />
    <PackageReference Include="OpenCvSharp4" Version="4.5.3.20210817" Condition="'$(TargetFramework)' == 'net461'" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.5.3.20210817" Condition="'$(TargetFramework)' == 'net461'" />
    <PackageReference Include="System.Drawing.Common" Version="5.0.3" Condition="'$(TargetFramework)' == 'net461'" />
    <Content Include="../../assets/models/**" Link="models/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="../../assets/brand/*.png" Link="brand/%(Filename)%(Extension)" />
    <Resource Include="../../assets/brand/AdaptaPE.ico" Link="brand/AdaptaPE.ico" />
    <Content Include="../../assets/brand/AdaptaPE.ico" Link="AdaptaPE.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../assets/speech-runtime/win-x64/*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="'$(PlatformTarget)' == 'x64'" />
    <Content Include="../../assets/speech-runtime/licenses/**" Link="licenses/speech/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../assets/installer/licenses/*" Link="licenses/installer/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../LICENSE;../../LICENSE.txt;../../THIRD_PARTY_NOTICES.md;../../LEEME.txt" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <PackageReference Include="System.Speech" Version="10.0.12" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48' Or '$(TargetFramework)' == 'net461'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Speech" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Security" />
  </ItemGroup>
</Project>
